---
---

<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#b02a32">
<title>{%if title%}{{title|safe}} · {%endif%}Pokémon: Tabletop Version</title>
{%if description%}<meta name="description" content="{{description|safe}}">{%endif%}
<style>
  @font-face {
    font-family: ₽;
    unicode-range: U+24, U+E300;
    src: url('data:font/woff2;base64,');
  }
  
  *, ::before, ::after { box-sizing: border-box }
  html {
    font: 1.1em/1.4 ₽, -apple-system, BlinkMacSystemFont, Segoe UI, system-ui, Roboto, Lato, Helvetica, sans-serif;
    background: #b02a32; /* for overscroll */
    text-size-adjust: 100%;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    padding: 0.5em;
    background: #eed;
  }

  img,
  svg {
    max-width: 100%;
    height: auto;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1em;
    background: #b02a32;
    margin: -0.5em -0.5em 0;
    padding: 0.5em;
    color: #fff;
  }
  header a { color: inherit }
  header > h1 {
    margin: 0;
    font: italic 1em Georgia, serif;
  }

  .siteName { text-decoration: none }
  .siteName > svg { vertical-align: middle }
  .✲ {
    vertical-align: top;
    font-size: small;
  }

  main {
    max-width: 92em;
    margin: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }
  h2 { border-bottom: 0.5px solid }

  dt { font-weight: bolder }
  dd { margin-left: 2ch }
  dd > p:first-child { margin-top: 0 }

  footer {
    margin: 6em 0 2em;
    font-size: smaller;
    text-align: center;
    clear: both;
  }
  .© { color: inherit }

  :target {
    scroll-margin: 30vmin;
    animation: targeted 2s;
  }
  @keyframes targeted {
    0% {
      outline: 1px dotted;
      background: #ff0;
      color: #000;
    }
    to { outline: 1px dotted transparent }
  }

  @media (prefers-reduced-motion: no-preference) {
    * { scroll-behavior: smooth }
  }
</style>

<header>
  <h1>
    <a href="/" class="siteName" rel="home">{% set width="2em" %}{% include 'dottler.njk' %} Pokémon: Tabletop Version</a><!--
    --><a class="✲" href="#™" rel="license">✲</a>
  </h1>

  <nav>
    <a href="/rules/">Rules</a>
    <a href="/dex/">Pokédex</a>
    <a href="/moves/">Moves</a>
    <a href="/abilities/">Abilities</a>
    <a href="/items/">Items</a>
  </nav>

  <form role="search" action="https://www.google.com/search">
    {# replace disabled="" with required="" when ready #}
    <input type="search" name="q"
      autocapitalize="off"
      size="14"
      pattern=".*?\S.*" title="Search for one or more terms"
      disabled=""
    ><input type="hidden" name="q" value="site:ptv.ti.gt">{#
    #}<input type="hidden" name="udm" value="14">{#
    #}<button disabled="">Search</button>
  </form>
</header>

<main>
{{content | safe}}
</main>

<footer>
  <small id="™">This site is not endorsed by or affiliated with <a class="©" href="https://www.pokemon.com/us/legal/">Pokémon © Nintendo/Creatures Inc/GAME FREAK. Pokémon and Pokémon character names ™ Nintendo.</a> Trademarks used for identification and reference only.</small>
</footer>
